# NEXORA Express Backend - Staging Environment Configuration Template
# Place in Render / Railway Environment Settings (Never commit actual secret values)

# Node runtime environment
NODE_ENV=production

# Server Port (Render and Railway set this dynamically; default 5001)
PORT=5001

# Cryptographically secure random staging JWT Secret (minimum 64 hex characters)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=generate_and_insert_secure_staging_jwt_secret_here

# MongoDB Atlas Staging Connection URI
# Must point strictly to nexora_ai_staging (never nexora_ai)
MONGODB_URI=mongodb+srv://nexora_staging_user:<PASSWORD>@nexora-cluster.mongodb.net/nexora_ai_staging?retryWrites=true&w=majority

# Frontend Staging URL for CORS and Socket.IO Origin Whitelist
# Must match the exact Vercel staging deployment domain (no trailing slash)
CLIENT_URL=https://nexora-staging.vercel.app

# MongoDB Connection Pooling Configuration
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20

# Authentication Rate Limiting Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=10
